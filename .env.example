GEMINI_API_KEY=AIzaSy...
# VPS в РФ: прокси для Gemini (undici ProxyAgent). Альтернатива: GEMINI_PROXY / HTTPS_PROXY
# GEMINI_HTTPS_PROXY=http://user:pass@host:port
# Опционально relay вместо прямого API:
# GEMINI_RELAY_URL=https://your-worker.example.com
# GEMINI_RELAY_SECRET=...
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Если id в токене обрезался при копировании — укажите явно (цифры ДО двоеточия):
# TELEGRAM_BOT_ID=8520170966
WEBAPP_URL=https://app.innoko.ru/app
# URL для внешнего health-check (опционально, по умолчанию origin из WEBAPP_URL)
# HEALTH_CHECK_URL=https://app.innoko.ru
TELEGRAM_BOT_USERNAME=viral_maker_ai_bot
# Опционально: отдельный @username для кнопки «Связаться с нами» (иначе — бот приложения)
# SUPPORT_TELEGRAM_USERNAME=your_support_username
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
# Альтернативные имена (как в Upstash) — код понимает оба варианта:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# Ссылка на оплату из кабинета Tribute (после /p/ могут быть буквы — это нормально)
TRIBUTE_PRO_WEBLINK=https://web.tribute.tg/p/abcXYZ
TRIBUTE_PREMIUM_WEBLINK=https://web.tribute.tg/p/defXYZ
# Числовой id для webhook (опционально — код сам декодирует slug из WEBLINK, vya → 121282)
# TRIBUTE_PRO_PRODUCT_ID=121282
# TRIBUTE_PREMIUM_PRODUCT_ID=121292
TRIBUTE_API_KEY=tribute_api_key_from_settings
# Webhook URL в кабинете Tribute → Settings → API Keys:
# https://app.innoko.ru/api/tribute-webhook
DEBUG_ADMIN_SECRET=change-me-on-vps
# Веб-вход на innoko.ru/app (можно = DEBUG_ADMIN_SECRET)
# SESSION_SECRET=long-random-string
# Локально без HTTPS: SESSION_COOKIE_SECURE=false
# Telegram user id владельца. Admin UI и admin API (блок «Тестовый доступ» и др.).
OWNER_TELEGRAM_ID=123456789
# Несколько владельцев — через запятую (приоритетнее OWNER_TELEGRAM_ID):
# OWNER_TELEGRAM_IDS=123456789,987654321
# Локально по умолчанию 3001 (3000 часто занят другими dev-серверами)
PORT=3001
